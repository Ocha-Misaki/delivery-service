    %ul.nav.nav-pills
      - if user_signed_in?
        %li.nav-item
          = link_to "注文一覧", users_orders_path, class: "nav-link"
        %li.nav-item
          = button_to 'ログアウト', destroy_user_session_path, method: :delete, class: "nav-link link-danger"
      - else
        %li.nav-item
          = link_to 'ログイン', new_user_session_path, class: "nav-link"
        %li.nav-item
          = link_to '新規登録', new_user_registration_path, class: "nav-link"
