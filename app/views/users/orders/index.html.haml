.row
  - @orders.each do |order|
    - order_item = order.order_item
    - if order_item.present?
      .col-sm-4.mb-3.mb-sm-0
        .card.mb-4
          .card-body.ms-2
            .fs-6.card-text.mx-3.fw-semibold= order_item.food_set_name
            .fs-6.card-text.mx-3.fw-semibold
              価格: #{order_item.food_set_price}円
            .fs-6.card-text.mx-3.fw-semibold
              重量: #{order_item.food_set_total_weight}g
            .fs-6.card-text.mx-3.fw-semibold
              冷蔵: #{order_item.food_set.refrigerated ? '要' : '不要'}
            .fs-6.card-text.mx-3.fw-semibold
              食品: #{order_item.food_set.foods.map(&:name).join(", ")}
            .fs-6.card-text.mx-3.fw-semibold
              = button_tag '配達を申し込む', class: 'btn btn-primary'
