.container
  .row.g-0.ms-3.mt-4.mb-5
    .col-md-6
      .card
        .card-body
          .fs-3.mb-3
            = @food_set.name
          .fs-6.card-text.mx-3.fw-semibold
            価格: #{@food_set.price}円
          .fs-6.card-text.mx-3.fw-semibold
            重量: #{@food_set.total_weight}g
          .fs-6.card-text.mx-3.fw-semibold
            冷蔵: #{@food_set.refrigerated ? '要' : '不要'}
          .fs-6.card-text.mx-3.fw-semibold
            食品: #{@food_set.foods.map(&:name).join(", ")}
