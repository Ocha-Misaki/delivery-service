.container
  .row.g-0.ms-3.mt-4.mb-5
    .col-md-6
      .fs-3.mb-3
        = @food.name
      .fs-5.mb-4
        アレルギー情報 #{simple_format(h(@food.allergy_info))}
      .hstack.mt-4.gap-4
        .p-2= link_to '編集', edit_admins_food_path(@food), class: "link-primary btn btn-outline-primary"
        .p-2= button_to '削除', admins_food_path(@food), method: :delete, data: { turbo_confirm: "本当に削除しますか？" } , class: "btn btn-danger "
