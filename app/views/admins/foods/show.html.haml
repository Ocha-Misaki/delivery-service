.container
  .row.g-0.ms-3.mt-4.mb-5
    .col-md-6
      .fs-3.mb-3
        = @food.name
      .fs-5.mb-4
        = simple_format(h(@food.allergy_info))
      .hstack.mt-4
        .p-2= link_to '編集', edit_admin_food_path(@food), class: "link-primary link-offset-1 me-1 text-decoration-none"
        .p-2= button_to '削除', admin_food_path(@food), method: :delete, data: { turbo_confirm: "本当に削除しますか？" } , class: "btn btn-success"

