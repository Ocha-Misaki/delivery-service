.container
  .row
    - @food_sets.each do |food_set|
      .col-sm-4.mb-3.mb-sm-0
        .card.mb-4
          = link_to admin_food_set_path(food_set), class: 'text-decoration-none' do
            .card-body.ms-2
              .fs-6.card-text.mx-3.fw-semibold= food_set.name
              .fs-6.card-text.mx-3.fw-semibold= price_including_tax_text(food_set)
              .fs-6.card-text.mx-3.fw-semibold= display_weight(food_set.total_weight)
              .fs-6.card-text.mx-3.fw-semibold= display_refrigerated(food_set.refrigerated)
              .fs-6.card-text.mx-3.fw-semibold= food_set.foods.map(&:name).join(", ")
