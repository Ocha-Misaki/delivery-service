.container
  .row
    - @food_sets.each do |food_set|
      .col-sm-4.mb-3.mb-sm-0
        .card.mb-4
          = link_to admins_food_set_path(food_set), class: 'text-decoration-none' do
            .card-body.ms-2
              .fs-6.card-text.mx-3.fw-semibold= food_set.name
              .fs-6.card-text.mx-3.fw-semibold= "価格: #{food_set.price}円"
              .fs-6.card-text.mx-3.fw-semibold= "重量: #{food_set.total_weight}g"
              .fs-6.card-text.mx-3.fw-semibold= "冷蔵: #{food_set.refrigerated? ? '要' : '不要'}"
              .fs-6.card-text.mx-3.my-3.fw-semibold= "食品: #{food_set.foods.map(&:name).join(", ")}"
              .fs-6.card-text.mx-3.my-3.fw-semibold
                - if food_set.recipe.attached?
                  レシピ添付
                - else
                  レシピ未添付
