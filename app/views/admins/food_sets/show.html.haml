.container
  .row.g-0.ms-3.mt-4.mb-5
    .col-md-6
      .card
        .card-body
          .fs-3.mb-3
            = @food_set.name
          .fs-6.card-text.mx-3.fw-semibold
            価格: #{@food_set.price_including_tax}円(税込)
          .fs-6.card-text.mx-3.fw-semibold
            重量: #{@food_set.total_weight}g
          .fs-6.card-text.mx-3.fw-semibold
            冷蔵: #{@food_set.refrigerated ? '要' : '不要'}
          .fs-6.card-text.mx-3.fw-semibold
            食品: #{@food_set.foods.map(&:name).join(", ")}

      .hstack.mt-4
        .p-2= link_to '編集', edit_admins_food_set_path(@food_set), class: "link-primary link-offset-1 me-1 text-decoration-none"
        .p-2= button_to '削除', admins_food_set_path(@food_set), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger"
